<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:smil="urn:oasis:names:tc:opendocument:xmlns:smil-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:meta><dc:title>Un Book Train pour la Schœlcher ? — diaporama modèle</dc:title><dc:creator>Séquence « Book Train » — modèle de correction</dc:creator></office:meta>
<office:font-face-decls><style:font-face style:name="Liberation Sans" svg:font-family="Liberation Sans"/></office:font-face-decls>
<office:automatic-styles>
<style:page-layout style:name="PM1"><style:page-layout-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:page-width="28.0cm" fo:page-height="15.75cm" style:print-orientation="landscape"/></style:page-layout>
<style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#f6f3ec" presentation:background-visible="true" presentation:background-objects-visible="true" presentation:transition-speed="medium" smil:type="fade" smil:subtype="crossfade"/></style:style>
<style:style style:name="gr_cadre" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none" draw:textarea-vertical-align="top" fo:padding="0.1cm"/></style:style>
<style:style style:name="gr_accroche" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#c45f0a" svg:stroke-width="0.08cm" draw:fill="none" draw:textarea-vertical-align="middle" fo:padding="0.2cm"/></style:style>
<style:style style:name="gr_filet" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#c45f0a" svg:stroke-width="0.12cm"/></style:style>
<style:style style:name="gr_image" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/></style:style>
<style:style style:name="P_titre1" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="40pt" style:font-name="Liberation Sans" fo:font-family="Liberation Sans" fo:color="#1d3557" fo:font-weight="bold"/></style:style>
<style:style style:name="P_sous" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="24pt" style:font-name="Liberation Sans" fo:font-family="Liberation Sans" fo:color="#1d3557"/></style:style>
<style:style style:name="P_accroche" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="28pt" style:font-name="Liberation Sans" fo:font-family="Liberation Sans" fo:color="#c45f0a" fo:font-weight="bold"/></style:style>
<style:style style:name="P_titre" style:family="paragraph"><style:text-properties fo:font-size="36pt" style:font-name="Liberation Sans" fo:font-family="Liberation Sans" fo:color="#1d3557" fo:font-weight="bold"/></style:style>
<style:style style:name="P_texte" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.45cm"/><style:text-properties fo:font-size="24pt" style:font-name="Liberation Sans" fo:font-family="Liberation Sans" fo:color="#1d3557"/></style:style>
</office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="PM1" draw:style-name="dp1"/></office:master-styles>
<office:body><office:presentation>
<draw:page draw:name="Diapo 1" draw:style-name="dp1" draw:master-page-name="Standard"><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="3.4cm" svg:width="25cm" svg:height="3.0cm"><draw:text-box><text:p text:style-name="P_titre1">Un Book Train pour la Schœlcher ?</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="6.8cm" svg:width="25cm" svg:height="1.4cm"><draw:text-box><text:p text:style-name="P_sous">Prénom NOM — 4e B</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="gr_accroche" draw:layer="layout" svg:x="3.0cm" svg:y="9.6cm" svg:width="22cm" svg:height="2.2cm"><draw:text-box><text:p text:style-name="P_accroche">24 wagonnets, 290 m de rails</text:p></draw:text-box></draw:frame></draw:page>
<draw:page draw:name="Diapo 2" draw:style-name="dp1" draw:master-page-name="Standard"><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="0.8cm" svg:width="25cm" svg:height="2.0cm"><draw:text-box><text:p text:style-name="P_titre">Le problème</text:p></draw:text-box></draw:frame><draw:line draw:style-name="gr_filet" svg:x1="1.5cm" svg:y1="2.9cm" svg:x2="6.5cm" svg:y2="2.9cm"/><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="3.8cm" svg:width="25cm" svg:height="10.5cm"><draw:text-box><text:p text:style-name="P_texte">• NYPL : les livres dorment sous Bryant Park, le lecteur est au 3ᵉ étage</text:p><text:p text:style-name="P_texte">• Schœlcher : un monument historique, des ouvrages fragiles</text:p><text:p text:style-name="P_texte">• Il faut les livrer vite, à plat, sans choc</text:p></draw:text-box></draw:frame></draw:page>
<draw:page draw:name="Diapo 3" draw:style-name="dp1" draw:master-page-name="Standard"><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="0.8cm" svg:width="25cm" svg:height="2.0cm"><draw:text-box><text:p text:style-name="P_titre">La solution technique : le Book Train</text:p></draw:text-box></draw:frame><draw:line draw:style-name="gr_filet" svg:x1="1.5cm" svg:y1="2.9cm" svg:x2="6.5cm" svg:y2="2.9cm"/><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="3.8cm" svg:width="25cm" svg:height="10.5cm"><draw:text-box><text:p text:style-name="P_texte">• 24 wagonnets électriques sur un rail</text:p><text:p text:style-name="P_texte">• 23 m par minute, soit environ 1,4 km/h</text:p><text:p text:style-name="P_texte">• Une nacelle à cardan : le livre reste à plat, même à la verticale</text:p></draw:text-box></draw:frame></draw:page>
<draw:page draw:name="Diapo 4" draw:style-name="dp1" draw:master-page-name="Standard"><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="0.8cm" svg:width="25cm" svg:height="2.0cm"><draw:text-box><text:p text:style-name="P_titre">L’algorigramme du trajet</text:p></draw:text-box></draw:frame><draw:line draw:style-name="gr_filet" svg:x1="1.5cm" svg:y1="2.9cm" svg:x2="6.5cm" svg:y2="2.9cm"/><draw:frame draw:style-name="gr_image" svg:x="1.5cm" svg:y="3.4cm" svg:width="5.5cm" svg:height="11.8cm"><draw:image><office:binary-data></office:binary-data></draw:image></draw:frame><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="8.2cm" svg:y="4.2cm" svg:width="18.3cm" svg:height="10cm"><draw:text-box><text:p text:style-name="P_texte">• Il se lit de haut en bas, du DÉBUT à la FIN.</text:p><text:p text:style-name="P_texte">• Chaque losange pose une question : NON fait attendre, OUI fait avancer.</text:p></draw:text-box></draw:frame></draw:page>
<draw:page draw:name="Diapo 5" draw:style-name="dp1" draw:master-page-name="Standard"><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="0.8cm" svg:width="25cm" svg:height="2.0cm"><draw:text-box><text:p text:style-name="P_titre">Qui décide, qui exécute ?</text:p></draw:text-box></draw:frame><draw:line draw:style-name="gr_filet" svg:x1="1.5cm" svg:y1="2.9cm" svg:x2="6.5cm" svg:y2="2.9cm"/><draw:frame draw:style-name="gr_image" svg:x="1.5cm" svg:y="3.4cm" svg:width="6.89cm" svg:height="11.8cm"><draw:image><office:binary-data></office:binary-data></draw:image></draw:frame><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="9.59cm" svg:y="4.2cm" svg:width="16.91cm" svg:height="10cm"><draw:text-box><text:p text:style-name="P_texte">• En haut, l’information décide : capteurs, automate, ordres</text:p><text:p text:style-name="P_texte">• En bas, l’énergie exécute : alimenter, distribuer, convertir, transmettre</text:p><text:p text:style-name="P_texte">• L’ordre descend : il arrive sur DISTRIBUER</text:p></draw:text-box></draw:frame></draw:page>
<draw:page draw:name="Diapo 6" draw:style-name="dp1" draw:master-page-name="Standard"><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="0.8cm" svg:width="25cm" svg:height="2.0cm"><draw:text-box><text:p text:style-name="P_titre">Le choix du format</text:p></draw:text-box></draw:frame><draw:line draw:style-name="gr_filet" svg:x1="1.5cm" svg:y1="2.9cm" svg:x2="6.5cm" svg:y2="2.9cm"/><draw:frame draw:style-name="gr_cadre" draw:layer="layout" svg:x="1.5cm" svg:y="3.8cm" svg:width="25cm" svg:height="10.5cm"><draw:text-box><text:p text:style-name="P_texte">• SVG : net à n’importe quel zoom, et léger (≈ 14 Ko)</text:p><text:p text:style-name="P_texte">• PNG à 300 % : accepté partout, même sur Pronote</text:p><text:p text:style-name="P_texte">• Le bon format, c’est celui qui convient à la destination</text:p></draw:text-box></draw:frame></draw:page>
</office:presentation></office:body>
</office:document>
