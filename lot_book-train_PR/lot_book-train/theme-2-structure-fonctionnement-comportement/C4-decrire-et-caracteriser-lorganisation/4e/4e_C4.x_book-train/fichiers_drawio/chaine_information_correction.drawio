        <mxCell id="communiquer" value="COMMUNIQUER&#10;&#10;① Ordres au variateur du moteur&#10;② Affichage au comptoir&#10;③ Signal « wagonnet disponible »" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3a46;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="710" y="220" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sortie" value="📚 INFORMATION UTILE :&#10;le livre demandé est arrivé au comptoir du 3ᵉ étage" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3f7;strokeColor=#2d3a46;strokeWidth=3;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="energie" value="CHAÎNE D'ÉNERGIE (rappel — EN BAS)&#10;Alimenter → Distribuer → Convertir → Transmettre → Action : déplacer le wagonnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0ef;strokeColor=#c0322b;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;fontColor=#8f221d" vertex="1" parent="1">
