        <mxCell id="e1" value="signaux" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2d3a46;strokeWidth=3;fontSize=11;flowAnimation=1;" edge="1" parent="1" source="acquerir" target="traiter"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="décisions" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2d3a46;strokeWidth=3;fontSize=11;flowAnimation=1;" edge="1" parent="1" source="traiter" target="communiquer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2d3a46;strokeWidth=3;flowAnimation=1;" edge="1" parent="1" source="communiquer" target="sortie"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="retro" value="rétroaction : les capteurs re-mesurent en continu" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7a5e28;strokeWidth=2;dashed=1;fontSize=10;fontColor=#7a5e28;exitX=0.5;exitY=1;entryX=0.5;entryY=1;flowAnimation=1;" edge="1" parent="1" source="traiter" target="acquerir"><mxGeometry relative="1" as="geometry" /></mxCell>
