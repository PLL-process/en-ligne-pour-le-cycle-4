<mxfile host="app.diagrams.net" type="device">
  <diagram id="info-correction" name="Chaîne d'information — CORRECTION">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titre" value="🧠 CHAÎNE D'INFORMATION DU BOOK TRAIN — CORRECTION&#10;(convention : information EN HAUT, énergie EN BAS, la flèche d'ORDRE part de COMMUNIQUER et descend)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#2d3a46;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="acquerir" value="ACQUÉRIR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3a46;strokeWidth=3;fontSize=14;fontStyle=1;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="① Terminal de commande&#10;(salle de lecture) → demande" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3f7;strokeColor=#2d3a46;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="② Capteurs de station&#10;le long du rail → position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3f7;strokeColor=#2d3a46;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="③ Capteur « wagonnet vacant »&#10;(chargement) → libre / occupé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3f7;strokeColor=#2d3a46;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="traiter" value="TRAITER&#10;&#10;Automate (PLC) + serveur central&#10;compare : position mesurée&#10;= destination programmée ?&#10;+ aiguille les 24 wagonnets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3a46;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1">
