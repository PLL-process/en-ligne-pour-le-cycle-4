<mxfile host="app.diagrams.net" type="device">
  <diagram id="info-eleve" name="Chaîne d'information — À COMPLÉTER">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titre" value="🧠 CHAÎNE D'INFORMATION DU BOOK TRAIN — À COMPLÉTER&#10;Le schéma général avait oublié les capteurs : à toi de réparer cet oubli !" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#2d3a46;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="50" as="geometry" />
        </mxCell>
        <mxCell id="consigne" value="ÉTAPE 1 : glisse les 3 blocs de la RÉSERVE dans les emplacements en pointillés du bloc ACQUÉRIR.&#10;ÉTAPE 2 : relie ACQUÉRIR → TRAITER → COMMUNIQUER (flèches pleines, étiquettes « signaux » et « décisions »).&#10;ÉTAPE 3 : trace la flèche d'ORDRE en pointillés ROUGES : elle part de COMMUNIQUER et DESCEND vers la chaîne d'énergie — jamais d'Acquérir ni de Traiter !" style="text;html=1;fontSize=12;fontColor=#8f221d;align=left;fillColor=#fbf0ef;strokeColor=#c0322b;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="acquerir" value="ACQUÉRIR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3a46;strokeWidth=3;fontSize=14;fontStyle=1;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="slot1" value="① … ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8a929c;strokeWidth=2;dashed=1;fontSize=12;fontColor=#8a929c" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="slot2" value="② … ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8a929c;strokeWidth=2;dashed=1;fontSize=12;fontColor=#8a929c" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="slot3" value="③ … ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8a929c;strokeWidth=2;dashed=1;fontSize=12;fontColor=#8a929c" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="traiter" value="TRAITER&#10;&#10;Automate (PLC) + serveur central&#10;compare : position mesurée&#10;= destination programmée ?&#10;+ aiguille les 24 wagonnets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3a46;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="communiquer" value="COMMUNIQUER&#10;&#10;① Ordres au variateur du moteur&#10;② Affichage au comptoir&#10;③ Signal « wagonnet disponible »" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3a46;strokeWidth=3;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="710" y="220" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="energie" value="CHAÎNE D'ÉNERGIE (rappel — EN BAS)&#10;Alimenter → Distribuer → Convertir → Transmettre → Action : déplacer le wagonnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0ef;strokeColor=#c0322b;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;fontColor=#8f221d" vertex="1" parent="1">
          <mxGeometry x="260" y="490" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="reserve" value="🧰 RÉSERVE DE BLOCS (à glisser dans ACQUÉRIR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf6ec;strokeColor=#a8823c;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;fontColor=#7a5e28" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="Capteurs de station&#10;le long du rail (≈ 290 m)&#10;→ position du wagonnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3f7;strokeColor=#2d3a46;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="70" y="635" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Terminal de commande&#10;(salle de lecture, 3ᵉ étage)&#10;→ demande du lecteur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3f7;strokeColor=#2d3a46;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="635" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="Capteur « wagonnet vacant »&#10;(poste de chargement, sous-sol)&#10;→ wagonnet libre ou non" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3f7;strokeColor=#2d3a46;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="590" y="635" width="240" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
