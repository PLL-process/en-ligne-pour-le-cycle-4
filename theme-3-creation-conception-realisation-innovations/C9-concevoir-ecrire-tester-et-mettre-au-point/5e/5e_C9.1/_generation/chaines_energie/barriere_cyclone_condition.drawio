fb454;strokeWidth=3;endArrow=block;endFill=1;startArrow=none;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1395" y="528" as="sourcePoint" /><mxPoint x="1570" y="528" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="49" value="Énergie&#10;mécanique" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#ffb454;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1430.02" y="447" width="105.96" height="50" as="geometry" /></mxCell><mxCell id="50" value="Ouvrir ou&#10;fermer la&#10;barrière" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1426.58" y="573" width="126.83999999999999" height="87" as="geometry" /></mxCell><mxCell id="51" value="Ta variable places est dans TRAITER : c’est elle qui décide, la barrière obéit." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="335.8" y="685" width="928.4" height="27" as="geometry" /></mxCell><mxCell id="52" value="À toi de lire : que fait la barrière si places vaut exactement 0 ? Pourquoi ce test est-il le plus important ?" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="187.9000000000001" y="731" width="1224.1999999999998" height="26" as="geometry" /></mxCell><mxCell id="53" value="Convention : l’information EN HAUT, l’énergie EN BAS — l’ordre descend, comme le cerveau commande les muscles." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="187.9000000000001" y="781" width="1224.1999999999998" height="26" as="geometry" /></mxCell></root></mxGraphModel>