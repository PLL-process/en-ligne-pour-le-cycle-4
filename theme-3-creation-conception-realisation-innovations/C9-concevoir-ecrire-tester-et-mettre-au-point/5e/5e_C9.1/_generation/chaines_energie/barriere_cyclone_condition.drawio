<mxfile host="app.diagrams.net" type="device"><diagram id="chaine" name="Barrière du Cyclone : l’information (en haut) commande l’énergie (en bas)"><mxGraphModel page="1" pageWidth="1600" pageHeight="835" background="#050f24" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Barrière du Cyclone : l’information (en haut) commande l’énergie (en bas)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="158.9000000000001" y="14" width="1282.1999999999998" height="37" as="geometry" /></mxCell><mxCell id="3" value="Ta variable places commande un objet réel." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=22;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="526.04" y="66" width="547.92" height="29" as="geometry" /></mxCell><mxCell id="4" value="CHAÎNE D’INFORMATION — en haut (elle décide)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#61dafb;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="117" width="598.9599999999999" height="30" as="geometry" /></mxCell><mxCell id="6" value="ACQUÉRIR" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#0d2347;strokeColor=#61dafb;strokeWidth=3;fontColor=#61dafb;fontSize=23;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="230" height="76" as="geometry" /></mxCell><mxCell id="7" value="Compteur des montées&#10;et des descentes" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=21;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="47.2" y="260" width="255.6" height="56" as="geometry" /></mxCell><mxCell id="9" value="TRAITER" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#0d2347;strokeColor=#c68ef2;strokeWidth=3;fontColor=#c68