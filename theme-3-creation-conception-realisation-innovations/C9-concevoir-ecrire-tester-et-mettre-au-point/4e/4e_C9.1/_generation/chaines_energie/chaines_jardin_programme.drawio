 x="1565" y="498" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="40" value="Énergie&#10;mécanique" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#ffb454;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1247.02" y="417" width="105.96" height="50" as="geometry" /></mxCell><mxCell id="41" value="Mettre l’eau&#10;en mouvement" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1412.44" y="538" width="165.11999999999998" height="58" as="geometry" /></mxCell><mxCell id="43" value="TRANSMETTRE" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=none;strokeColor=#9aa5b8;strokeWidth=3;dashed=1;dashPattern=8 6;fixDash=1;fontColor=#9aa5b8;fontSize=23;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1135" y="535" width="210" height="76" as="geometry" /></mxCell><mxCell id="44" value="Absente : la pompe met&#10;elle-même l’eau en mouvement" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#9aa5b8;fontSize=19;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1079.72" y="627" width="320.56" height="52" as="geometry" /></mxCell><mxCell id="45" value="CIRCUIT D’EAU — trajet de la matière, distinct des flèches d’énergie" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#61dafb;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="722" width="919.1199999999999" height="30" as="geometry" /></mxCell><mxCell id="46" value="Réservoir" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="131.36" y="791" width="137.27999999999997" height="31" as="geometry" /></mxCell><mxCell id="47" value="Pompe" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="579.2" y="791" width="81.6" height="31" as="geometry" /></mxCell><mxCell id="48" value="Sol du jardin" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="983.52" y="791" width="192.95999999999998" height="31" as="geometry" /></mxCell><mxCell id="49" style="edgeStyle=none;html=0;strokeColor=#61dafb;strokeWidth=3;endArrow=block;endFill=1;startArrow=none;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="282.64" y="806" as="sourcePoint" /><mxPoint x="565.2" y="806" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="50" value="Eau" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#61dafb;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="402.26" y="768" width="43.31999999999999" height="25" as="geometry" /></mxCell><mxCell id="51" style="edgeStyle=none;html=0;strokeColor=#61dafb;strokeWidth=3;endArrow=block;endFill=1;startArrow=none;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="674.8" y="806" as="sourcePoint" /><mxPoint x="969.52" y="806" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="52" value="Eau" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#61dafb;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="800.5" y="768" width="43.31999999999999" height="25" as="geometry" /></mxCell><mxCell id="53" value="Pourquoi un relais ? La pompe 12 V demande bien plus de courant qu’une broche de la carte n’en fournit." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="226.47000000000003" y="876" width="1147.06" height="26" as="geometry" /></mxCell><mxCell id="54" value="Le relais reçoit l’ordre et laisse passer l’énergie de l’alimentation : il distribue, il ne fabrique rien." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="209.94000000000005" y="916" width="1180.12" height="26" as="geometry" /></mxCell><mxCell id="55" value="Avec un simple voyant, la broche de la carte suffirait : l’ordre arrive toujours sur DISTRIBUER." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="265.0400000000001" y="956" width="1069.9199999999998" height="26" as="geometry" /></mxCell><mxCell id="56" value="Convention : l’information EN HAUT, l’énergie EN BAS — l’ordre descend, comme le cerveau commande les muscles." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156.0" y="1015" width="1288.0" height="27" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
