</mxGeometry></mxCell><mxCell id="86" value="Énergie&#10;mécanique" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#ffb454;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1402.02" y="1344" width="105.96" height="50" as="geometry" /></mxCell><mxCell id="87" value="Le vantail&#10;se ferme" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1405.2" y="1476" width="139.6" height="58" as="geometry" /></mxCell><mxCell id="88" value="Le préactionneur choisit aussi" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="422.4" y="1559" width="325.2" height="25" as="geometry" /></mxCell><mxCell id="89" value="le sens de rotation" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="479.82" y="1585" width="210.35999999999999" height="25" as="geometry" /></mxCell><mxCell id="90" value="C’est parce que quelque chose se DÉPLACE qu’il faut TRANSMETTRE : allumer et sonner ne déplacent rien." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81aaff;fontSize=19;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="231.98000000000002" y="1613" width="1136.04" height="26" as="geometry" /></mxCell><mxCell id="91" value="➜ L’ordre arrive sur DISTRIBUER : ici un pont en H séparé, et la chaîne est complète." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#81fba1;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="276.35" y="1646" width="1047.3" height="28" as="geometry" /></mxCell><mxCell id="92" value="La règle : l’ordre arrive TOUJOURS sur DISTRIBUER." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#ffd66b;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="431.5" y="1700" width="737.0" height="32" as="geometry" /></mxCell><mxCell id="93" value="Le préactionneur — sortie de la carte, transistor intégré au module ou carte séparée — se dit sous le bloc." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontColor=#e4eaf5;fontSize=20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="173.4000000000001" y="1742" width="1253.1999999999998" height="27" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
